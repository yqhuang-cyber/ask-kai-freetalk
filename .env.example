# Independent local POC. Business interfaces use mock HSKai by default.
ASK_KAI_HOST=127.0.0.1
ASK_KAI_PORT=4310
ASK_KAI_BACKEND=mock
# Disconnected voice preview; /dev/replay remains explicitly synthetic.
# Change to doubao after setting the key and reviewed profile below.
ASK_KAI_PROVIDER=replay

# Dynamic initialization + MiniMax M3 turn planning, with Doubao full duplex kept.
# Current duplex applies turn plans only at reply boundaries for subsequent input.
# controlled is blocked until actual generation gating is verified.
ASK_KAI_PLANNING_MODE=next_turn_advisory
# Set legacy to run the old fixed-plan behavior; shadow never changes replies.
# A missing key is explicitly recorded as conservative rule fallback.
ASK_KAI_PLANNER_PROVIDER=minimax
# Draft is an experimental, provider-independent contract; M3 comparison has
# not demonstrated better acceptance. Keep full contract by default; both
# paths use current provider-independent Agent reasoning instructions.
ASK_KAI_PLANNER_PROTOCOL=full_contract_v3
# ASK_KAI_PLANNER_PROTOCOL=draft_v1
# MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_PLANNER_MODEL=MiniMax-M3

# Step 2 probe only. Create a reviewed profile after obtaining the full API spec.
# Keys stay in your local .env; never put them in a profile or send them in chat.
# Copy docs/protocol/seeduplex-profile.template.json to this path and review it.
# DOUBAO_PROBE_PROFILE=./.local/seeduplex-profile.json
# DOUBAO_API_KEY=
# Web realtime requires a separately reviewed complete audio/event profile.
# DOUBAO_REALTIME_PROFILE=./.local/seeduplex-profile.json
# Seeduplex protocol review, ACK-order review and live acceptance are separate.
# See docs/protocol/seeduplex-integration.md; do not mark review flags automatically.
# POC creates its local mock service and signing secret automatically.
# No HSKai repository, account, endpoint or secret is required.
# The following are only for a future, explicit ASK_KAI_BACKEND=external setup.
# Mock mode ignores these external settings.
# HSKAI_BRIDGE_SECRET=
# HSKAI_ALLOWED_MARKETS=SG
# HSKAI_MEMORY_ENDPOINT=https://your-hskai-host/internal/ask-kai/memory
# HSKAI_SAFEGUARDING_ENDPOINT=https://your-hskai-host/internal/ask-kai/safeguarding
# HSKAI_PRIVACY_ENDPOINT=https://your-hskai-host/internal/ask-kai/privacy
ASK_KAI_RELEASE_MODE=internal
# EVAL_JUDGE_BASE_URL=https://your-reviewed-judge-endpoint/v1
# EVAL_JUDGE_API_KEY=
# EVAL_JUDGE_MODEL=
# EVAL_JUDGE_VERSION=
# LANGFUSE_BASE_URL=https://your-langfuse-host
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_TRACE_MAP=./.local/trace-map.json
# EVAL_RUN_ID=
# ASK_KAI_RELEASE_EVIDENCE=./.local/release-evidence.json
# ASK_KAI_CONTENT_REPORT=./.local/content-report.json
# ASK_KAI_CANDIDATE_REVISION=

# Optional fixed-demo slides control; default off. Requires reviewed Seeduplex.
# ASK_KAI_SLIDES_CONTROL=false
# Mock-only author presentation of pages 1,2,3; never learner progress evidence.
# ASK_KAI_SLIDES_DEMO_HISTORY=false

# Optional teacher homework preparation (separate from FreeTalk Planner)
# ASK_KAI_TA_TEXT_PROVIDER=minimax
# Uses the existing server-side MINIMAX_API_KEY and registered MiniMax-M3 transport.
# Parallel trial: use another port, database and cookie; ports alone do not isolate cookies.
# ASK_KAI_TA_PORT=4331
# ASK_KAI_TA_COOKIE_NAME=ask_kai_ta_ai_session
# ASK_KAI_TA_DATABASE=.local/teacher-ai-planning/homework.sqlite
# ASK_KAI_TA_VOICE_PROFILE=/absolute/path/to/reviewed/profile.json
